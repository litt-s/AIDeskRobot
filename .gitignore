node_modules/
dist/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
*.log
# ---- ESP-IDF：构建产物与组件管理器下载的依赖（数百 MB，可由 idf.py 重新生成）----
Hardware/esp32/build/
Hardware/esp32/managed_components/

# ---- 本机的 sdkconfig 含真实设备码（CONFIG_ROBOT_CLOUD_KEY）----
# 设备码属于配网页/NVS 的逐台配置，不得进公开仓库
Hardware/esp32/sdkconfig
Hardware/esp32/sdkconfig.old
Hardware/esp32/dependencies.lock

# ---- 编辑期间的临时文件 ----
tmp-*
# ---- 线上 D1 快照：含用户口令哈希/设备密钥/模型密钥密文，禁止入库 ----
backups/

# ---- 烟测脚本的产物（scripts/volc-voice-smoke.mjs 每次都写到仓库根目录）----
volc-tts-smoke.mp3

# ---- CloudBase 容器版：Node 打包产物与本机 SQLite 数据（真库，含用户/设备数据）----
dist-server/
data/
# ---- 播种文件含真实账号/设备/凭据密文，只在本机生成、只进代码包，不入库 ----
seed/*.sql

# ---- PC 桌面端打包产物 ----
desktop/release/
# ---- Android build ----
Android/.gradle/
Android/build/
Android/app/build/
Android/local.properties
Android/.idea/
Android/*.iml
# ---- Local portable build tool cache ----
.tools/
