CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_AES_USE_INTERRUPT=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_SPIFFS_USE_MAGIC=y
CONFIG_SPIFFS_USE_MAGIC_LENGTH=y
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_ROBOT_ENABLE_ESP_SR=y
CONFIG_ROBOT_ENABLE_GESTURE=y
CONFIG_ROBOT_ENABLE_RANDOM_ANIMATION=y
CONFIG_ROBOT_ENABLE_SERVO=y
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=3

# ---- 公网托管下的 TCP 吞吐（2026-10-15 T039 追加）----
# 设备与云托管之间的 RTT 实测 ~111 ms，而 lwIP 默认收发窗口只有 5760 字节：
# 5760 B / 0.111 s ≈ 52 KB/s，扣除 TLS 与解析开销后实测只有 18 KB/s，
# 而音频恒定要 32 KB/s（录音上传同样受限：320 KB 要传 18 秒）。
# 放大窗口/发送缓冲是标准做法；配合 SPIRAM 分配避免挤占内部 RAM。
CONFIG_LWIP_TCP_WND_DEFAULT=20000
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=20000
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
